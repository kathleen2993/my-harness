{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-write.mjs\"" }
        ]
      },
      {
        "matcher": "mcp__.*use_figma",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/harness/scripts/guard-figma-readonly.mjs\"" }
        ]
      }
    ]
  }
}
